{
  "name": "@tamtamchik/app-store-receipt-parser",
  "version": "2.3.0",
  "description": "A lightweight TypeScript library for extracting selected fields from Apple's ASN.1 encoded receipts.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "author": "Yuri Tkachenko <yuri.tam.tkachenko@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/tamtamchik/app-store-receipt-parser#readme",
  "bugs": {
    "url": "https://github.com/tamtamchik/app-store-receipt-parser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/tamtamchik/app-store-receipt-parser.git"
  },
  "keywords": [
    "apple",
    "receipt",
    "parser",
    "ASN.1",
    "in-app",
    "transaction",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "dependencies": {
    "asn1js": "^3.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.6.0",
    "c8": "^11.0.0",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "npm run build -- --watch src",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "node --import tsx --test test/*.test.ts",
    "coverage": "c8 --reporter=text --reporter=lcov node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  }
}
